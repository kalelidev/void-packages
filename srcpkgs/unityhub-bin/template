# Template file for 'unityhub-bin'
pkgname=unityhub-bin
version=3.18.0
revision=1
archs="x86_64"
hostmakedepends="dpkg tar"
depends="gtk+3 libnotify nss libXScrnSaver libXtst xdg-utils at-spi2-atk at-spi2-core util-linux libsecret p7zip zip unzip tar libayatana-appindicator vulkan-loader libvips"
short_desc="Unity Hub - official launcher and manager for Unity projects"
maintainer="Orphaned <orphan@voidlinux.org>"
license="custom:Proprietary"
homepage="https://unity.com/"
distfiles="https://hub.unity3d.com/linux/repos/deb/pool/main/u/unity/unityhub_amd64/UnityHubSetup-${version}-amd64.deb"
checksum="24392617c00dbd6d23e4bfbdda9ad471516a0db5065e4c715193e3b4eab00e59"
nostrip="yes"
noverifyrdeps="yes"

do_extract() {
	mkdir -p ${wrksrc}/deb
	dpkg-deb -x ${XBPS_SRCDISTDIR}/${pkgname}-${version}/UnityHubSetup-${version}-amd64.deb ${wrksrc}/deb
}

do_install() {
	vmkdir /opt
	cp -r ${wrksrc}/deb/opt/unityhub ${DESTDIR}/opt/

	# launcher
	vmkdir /usr/bin

	cat > ${DESTDIR}/usr/bin/unityhub << 'EOF'
#!/bin/sh
cd /opt/unityhub || exit 1
exec ./unityhub-bin "$@"
EOF

	chmod +x ${DESTDIR}/usr/bin/unityhub
	ln -sf unityhub ${DESTDIR}/usr/bin/UnityHub

	# desktop files
	vinstall ${FILESDIR}/applications/unityhub.desktop 644 \
    usr/share/applications

	# icons
	vcopy ${FILESDIR}/icons usr/share
}
